#!/bin/bash
# pre-push: block force-push / history rewrite on any branch.

set -u

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  repo=$(basename "$(git rev-parse --show-toplevel)")

  # A new branch has no remote sha yet; a deletion has no local one. Neither is
  # a rewrite, so both pass straight through. Without the second line,
  # `git push --delete` reads as erasing history.
  [ "$remote_sha" = "0000000000000000000000000000000000000000" ] && continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "[pre-push] ✗ $repo → $branch: force push blocked — would erase history"
    exit 1
  fi
done
exit 0
